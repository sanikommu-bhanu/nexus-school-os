# Copy this file to .env.local and fill in values from your Firebase project
# (Project Settings → General → Your apps → SDK setup and configuration).
# All Firebase free-tier services — no billing required for this app to run.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------
# Local Firebase emulator mode.
# Set to 1 to point Auth + Firestore at the local emulators instead of
# the real project — lets you exercise firestore.rules and real writes
# without touching production data. Ports mirror firebase.json.
#
#   npm run emulators      # terminal 1 (needs Java 11+ on PATH)
#   npm run dev:emulator   # terminal 2
#
# When this is 1, the Firebase API key and project id above may be left
# blank — the emulator does not validate them.
# ------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_AUTH_EMULATOR_PORT=9099

# Optional, added when the AI service layer is wired up (Gemini free tier).
# Never exposed to the client — read only on a server route/handler.
GEMINI_API_KEY=

# Optional override for the models lib/ai/provider.ts tries, in order,
# comma-separated. Leave blank to use the built-in defaults.
#
# Worth knowing: Google retires model ids, and a retired one returns 404
# "no longer available to new users" — which the app surfaces as
# "NEXUS AI is temporarily unavailable" even though the key is perfectly
# valid. That is exactly what happened to the original gemini-2.5-flash /
# gemini-1.5-flash defaults. If AI stops answering while /api/ai/status
# still reports configured:true, list the models your key can actually
# call and put a working one here:
#
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
#
# ListModels over-reports — a model can be listed and still 404 on
# generateContent, so confirm with an actual generateContent call.
GEMINI_MODELS=gemini-2.5-flash

# ------------------------------------------------------------
# Cloudinary — file storage for document uploads (lib/cloudinary.ts).
# Replaces Firebase Storage, which requires the paid Blaze plan;
# Cloudinary's free tier needs no card. Firebase Auth and Firestore
# are unaffected.
#
# Cloud name: Cloudinary dashboard → Programmable Media → Dashboard.
#
# Upload preset: Settings → Upload → Upload presets → "Add upload
# preset", and set its **Signing Mode to "Unsigned"**. Unsigned is
# what lets the browser upload directly, so the Cloudinary API secret
# never has to ship to the client. A signed preset would require an
# API secret in the request and cannot be used from client code.
# Set the preset's "Folder"/access restrictions in the dashboard if
# you want a server-side ceiling on where uploads can land.
#
# Both are NEXT_PUBLIC_* because the browser performs the upload —
# neither value is a secret, unlike the API secret, which this app
# never reads.
# ------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------------------
# Upstash Redis — OPTIONAL, enables distributed AI rate limiting
# (lib/ai/rate-limit.ts).
#
# Leave both blank and the limiter uses a per-process in-memory
# counter. That is correct on a single long-lived server, but on
# serverless each warm instance keeps its own count, so N instances
# allow up to N x the intended limit.
#
# Set both and the limit becomes a single shared fixed-window counter
# that holds across every instance. Upstash is used over its REST API
# with plain `fetch`, so there is no connection pool to exhaust and no
# extra npm dependency. Free tier, no card.
#
# Get them at: https://console.upstash.com → create a Redis database
# → "REST API" → UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
#
# These are server-only (no NEXT_PUBLIC_ prefix) — the token must
# never reach the browser.
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
