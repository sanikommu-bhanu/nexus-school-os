# Copy this file to .env.local and fill in values from your Firebase project
# (Project Settings → General → Your apps → SDK setup and configuration).
# All Firebase free-tier services — no billing required for this app to run.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional, added when the AI service layer is wired up (Gemini free tier).
# Never exposed to the client — read only on a server route/handler.
GEMINI_API_KEY=

# ------------------------------------------------------------
# Cloudinary — file storage for document uploads (lib/cloudinary.ts).
# Replaces Firebase Storage, which requires the paid Blaze plan;
# Cloudinary's free tier needs no card. Firebase Auth and Firestore
# are unaffected.
#
# Cloud name: Cloudinary dashboard → Programmable Media → Dashboard.
#
# Upload preset: Settings → Upload → Upload presets → "Add upload
# preset", and set its **Signing Mode to "Unsigned"**. Unsigned is
# what lets the browser upload directly, so the Cloudinary API secret
# never has to ship to the client. A signed preset would require an
# API secret in the request and cannot be used from client code.
# Set the preset's "Folder"/access restrictions in the dashboard if
# you want a server-side ceiling on where uploads can land.
#
# Both are NEXT_PUBLIC_* because the browser performs the upload —
# neither value is a secret, unlike the API secret, which this app
# never reads.
# ------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
