{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev:emulator": "cross-env NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1 next dev",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project nexus-school-os",
    "test:timetable": "node --experimental-strip-types tests/timetable-conflicts.test.ts",
    "check:emulator": "node scripts/check-emulator-prereqs.mjs",
    "test:rules": "node tests/rules.test.mjs",
    "test:rules:ci": "npm run check:emulator && firebase emulators:exec --only firestore --project nexus-school-os \"node tests/rules.test.mjs\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "10.12.4",
    "framer-motion": "11.3.19",
    "html5-qrcode": "2.3.8",
    "lucide-react": "0.417.0",
    "next": "14.2.5",
    "qrcode.react": "3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.4.0",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "20.14.13",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4"
  }
}
